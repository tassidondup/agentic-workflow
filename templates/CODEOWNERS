# Installed as .github/CODEOWNERS. The installer replaces @APPROVER with the approver account(s) and adds the
# runner config files named in workflow.config.json test.harness (other than vitest.config.*).
# Protected paths: changes need a code-owner review (see ruleset.json require_code_owner_review).
/tests/acceptance/ @APPROVER
/tests/harness/ @APPROVER
/vitest.config.* @APPROVER
/.workflow/ @APPROVER
/.github/ @APPROVER
/workflow.config.json @APPROVER
/AGENTS.md @APPROVER
/roles/ @APPROVER
/docs/specs/ @APPROVER
/docs/decisions/ @APPROVER
/docs/changes/*/approvals/ @APPROVER
/docs/changes/*/baseline.json @APPROVER
/docs/changes/*/design/ @APPROVER
/docs/changes/*/tests/ @APPROVER
